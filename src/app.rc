#include <windows.h>
#include "version.h"

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CAPVIEW_VERSION_MAJOR, CAPVIEW_VERSION_MINOR, CAPVIEW_VERSION_PATCH, 0
PRODUCTVERSION CAPVIEW_VERSION_MAJOR, CAPVIEW_VERSION_MINOR, CAPVIEW_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "CapView"
      VALUE "FileDescription", "CapView - plug-and-play capture card viewer"
      VALUE "FileVersion", CAPVIEW_VERSION_STR
      VALUE "InternalName", "CapView"
      VALUE "LegalCopyright", "Copyright (C) 2026 Vashu Chogada. MIT License."
      VALUE "OriginalFilename", "CapView.exe"
      VALUE "ProductName", "CapView"
      VALUE "ProductVersion", CAPVIEW_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
